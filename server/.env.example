# Port the server will listen on
PORT=5000

# Your Google Cloud YouTube Data API v3 key
# Get one at: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_api_key_here

# Allowed frontend origin for CORS
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Configuration
# Local PostgreSQL default (PostgreSQL 18 is running on port 5432):
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_postgres_password_here
PGDATABASE=beatstream_db

# Or full connection URL (e.g. for Supabase / Neon / Render / Railway):
# DATABASE_URL=postgresql://postgres:password@localhost:5432/beatstream_db
